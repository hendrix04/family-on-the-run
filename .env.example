# The browser uses its own origin by default, including the /v1 WebSocket proxy.
# For separate frontend hosting, set the externally reachable SpacetimeDB URL.
# VITE_SPACETIMEDB_HOST=https://your-spacetime-host.example
VITE_SPACETIMEDB_DB_NAME=family-on-the-run
# Optional hostname allowed to reach the Vite development server through a tunnel.
# VITE_DEV_ALLOWED_HOST=your-preview-host.example
# Potential oauth in the future
# GOOGLE_OAUTH_CLIENT=whatever
# GOOGLE_OAUTH_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
